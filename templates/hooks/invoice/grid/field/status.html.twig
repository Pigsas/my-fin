{% if data.value === 'paid' %}
    <span class="badge bg-success text-white">{{ data|trans }}</span>
{% elseif data.value === 'not_paid' %}
    <span class="badge bg-warning text-dark">{{ data|trans }}</span>
{% elseif data.value === 'expired' %}
    <span class="badge bg-danger text-white">{{ data|trans }}</span>
{% elseif data.value === 'draft' %}
    <span class="badge bg-secondary text-dark">{{ data|trans }}</span>
{% elseif data.value === 'closed' %}
    <span class="badge bg-dark text-white">{{ data|trans }}</span>
{% else %}
    {{ data|trans }}
{% endif %}
